# [Minix] Reference template for scripts/.env (gitignored). Create
# scripts/.env yourself and point these vars at your out-of-repo secret env
# files (for example, kept in iCloud). NOTHING secret lives here — only paths
# plus optional non-secret overrides.
#
# --- iOS: App Store Connect (asc) ---------------------------------------------
# MINIX_ASC_ENV points at a shell file that exports:
#   export ASC_KEY_ID="XXXXXXXXXX"
#   export ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
#   export ASC_PRIVATE_KEY_PATH="$HOME/path/to/AuthKey_XXXXXXXXXX.p8"
# (asc reads these from the environment — no keychain, no prompts.)
export MINIX_ASC_ENV="$HOME/path/to/asc.env"

# --- Android: release signing -------------------------------------------------
# MINIX_ANDROID_ENV points at a shell file that exports:
#   export ANDROID_KEYSTORE_FILE="$HOME/path/to/minix-release.jks"
#   export ANDROID_KEYSTORE_PASSWORD="..."
#   export ANDROID_KEY_ALIAS="minix"
#   export ANDROID_KEY_PASSWORD="..."
# (gradle reads these via System.getenv; $HOME is expanded by the shell first.)
export MINIX_ANDROID_ENV="$HOME/path/to/android.env"

# --- Optional: external TestFlight group name override (default External) ------
# export ASC_EXTERNAL_GROUP="External"
